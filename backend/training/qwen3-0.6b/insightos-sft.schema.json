{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:insightos:schemas:qwen3-sft-v1",
  "title": "InsightOS Qwen3 supervised fine-tuning example",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "scenario_group",
    "category",
    "split",
    "messages",
    "tools",
    "source",
    "license",
    "validation_status",
    "reviewer_notes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "scenario_group": {
      "type": "string",
      "minLength": 1,
      "description": "Stable group key used to keep related or near-duplicate examples in one split."
    },
    "category": {
      "enum": [
        "business_reasoning",
        "schema_interpretation",
        "structured_output",
        "tool_selection",
        "grounding_safety"
      ]
    },
    "split": {
      "enum": [
        "train",
        "validation",
        "test"
      ]
    },
    "messages": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/message"
      },
      "description": "TRL conversational SFT messages; assistant messages contain the target response."
    },
    "tools": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tool"
      },
      "description": "Only approved InsightOS provider schemas relevant to this example."
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reference"
      ],
      "properties": {
        "kind": {
          "enum": [
            "synthetic",
            "public"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "accessed_on": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "description": "Use an explicit license identifier or state that the example is original synthetic content."
    },
    "validation_status": {
      "enum": [
        "draft",
        "reviewed",
        "approved",
        "rejected"
      ]
    },
    "reviewer_notes": {
      "type": "string"
    }
  },
  "$defs": {
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "content"
      ],
      "properties": {
        "role": {
          "enum": [
            "system",
            "user",
            "assistant",
            "tool"
          ]
        },
        "content": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "tool_call_id": {
          "type": "string"
        },
        "tool_calls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "function"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "const": "function"
              },
              "function": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "arguments"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "arguments": {
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "function"
      ],
      "properties": {
        "type": {
          "const": "function"
        },
        "function": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "description",
            "parameters"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "parameters": {
              "type": "object"
            }
          }
        }
      }
    }
  }
}
