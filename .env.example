# ============================================
# InsightOS - Environment Configuration
# ============================================

# Application
APP_NAME=InsightOS
APP_VERSION=0.1.0
ENVIRONMENT=development

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Phase 5A assistant (provider calls are disabled unless explicitly configured)
INSIGHTOS_LLM_PROVIDER=none
INSIGHTOS_LLM_TIMEOUT_SECONDS=30
INSIGHTOS_LLM_MAX_OUTPUT_TOKENS=1200
INSIGHTOS_AGENT_MAX_MODEL_TURNS=4
INSIGHTOS_AGENT_MAX_TOOL_CALLS=6
INSIGHTOS_AGENT_MAX_HISTORY_MESSAGES=40
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct

# Per-role model overrides (leave blank to use OLLAMA_MODEL for all roles).
# Activate only after approved live validation of the target model.
# INSIGHTOS_LLM_MODEL_ORCHESTRATOR=
# INSIGHTOS_LLM_MODEL_DATA_INTELLIGENCE=
# INSIGHTOS_LLM_MODEL_ANALYTICS=
# INSIGHTOS_LLM_MODEL_PRESENTATION=

# Ollama model keep_alive (seconds). Omit to use Ollama default TTL (~5 min).
# Set to 0 to unload the model immediately after each request (saves RAM).
# INSIGHTOS_OLLAMA_KEEP_ALIVE=300
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_API_KEY=

# Frontend
FRONTEND_PORT=5173

# PostgreSQL
POSTGRES_DB=insightos
POSTGRES_USER=insightos
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://insightos:change_me@postgres:5432/insightos

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# MinIO / Object Storage
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=change_me
MINIO_SECRET_KEY=change_me
MINIO_SECURE=false

# InsightOS Buckets
MINIO_RAW_BUCKET=insightos-raw
MINIO_PROCESSED_BUCKET=insightos-processed
MINIO_EXPORTS_BUCKET=insightos-exports

# Data Limits
MAX_DATASET_SIZE_MB=150
MAX_JSON_ESTIMATED_DECODED_MB=256

# Logging
LOG_LEVEL=INFO
# CORS
# Comma-separated list of frontend origins allowed by CORSMiddleware.
# Defaults to http://localhost:5173,http://localhost:4173 when not set.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
