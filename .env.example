# ============================================
# InsightOS - Environment Configuration
# ============================================

# Application
APP_NAME=InsightOS
APP_VERSION=0.1.0
ENVIRONMENT=development

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend
FRONTEND_PORT=5173

# PostgreSQL
POSTGRES_DB=insightos
POSTGRES_USER=insightos
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://insightos:change_me@postgres:5432/insightos

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# MinIO / Object Storage
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=change_me
MINIO_SECRET_KEY=change_me
MINIO_SECURE=false

# InsightOS Buckets
MINIO_RAW_BUCKET=insightos-raw
MINIO_PROCESSED_BUCKET=insightos-processed
MINIO_EXPORTS_BUCKET=insightos-exports

# Data Limits
MAX_DATASET_SIZE_MB=150
MAX_FOLDER_SIZE_MB=500
MAX_ZIP_SIZE_MB=600
MAX_WORKING_SIZE_MB=1024

# Dataset Lifecycle
DATASET_INACTIVITY_EXPIRATION_HOURS=24

# Worker
WORKER_CONCURRENCY=2

# Logging
LOG_LEVEL=INFO